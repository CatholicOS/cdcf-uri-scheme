; ============================================================================
; Appendix D: Formal ABNF Grammar for the cdcf: URI Scheme
; draft-cdcf-catholic-uri-scheme-04 · version 0.5.0
;
; This grammar is NORMATIVE. Any cdcf: identifier that does not conform to
; these productions is invalid. Implementations MUST reject non-conforming
; identifiers. Future domains introduced by sub-specifications MUST extend
; this grammar via a patch release of the main specification (see
; spec/06-governance.md §6.5).
;
; Notation per RFC 5234 (https://www.rfc-editor.org/rfc/rfc5234).
;
; Changes since 0.3.0:
;   [REV-03] concept-path is an opaque CN-prefixed ID, not a slug (§3.5)
;   [REV-03] osis-book must be the exact lower-cased OSIS 2.1.1 book ID
;   [REV-04] "person" domain and person-path withdrawn (§3.6.1)
;   [REV-04] "work" domain and work-path added (§3.6)
;   [REV-04] concept-path prefix written as a case-sensitive hex literal
;   [REV-04] papal issuer-slug ordinal only where part of the official name
; ============================================================================

; ── Core character classes ───────────────────────────────────────────────────
ALPHA    = %x61-7A                          ; a-z (lower-case only)
DIGIT    = %x30-39                          ; 0-9
HYPHEN   = %x2D                             ; -
SLASH    = %x2F                             ; /
slug     = 1*(ALPHA / DIGIT / HYPHEN)       ; general-purpose slug
roman    = 1*(%x69 / %x76 / %x78 / %x6C / %x63 / %x64 / %x6D)
                                             ; i v x l c d m (Roman numerals)
iso-date = 4DIGIT HYPHEN 2DIGIT HYPHEN 2DIGIT  ; YYYY-MM-DD

; ── Top-level production ─────────────────────────────────────────────────────
; A cdcf: identifier is a domain followed by a slash and a domain path
cdcf-id  = domain SLASH domain-path
domain   = "verse" / "book" / "magisterium" / "ccc" / "canon"
         / "concept" / "work" / "institution" / "rel"

; ── Scripture ─────────────────────────────────────────────────────────────────
domain-path =/ verse-path / book-path
book-path    = osis-book
verse-path   = osis-book SLASH chapter [SLASH verse-ref]
osis-book    = slug                          ; the exact lower-cased OSIS 2.1.1 book ID
                                             ; (e.g. "john", not "jn")
chapter      = 1*DIGIT
verse-ref    = 1*DIGIT [HYPHEN 1*DIGIT]      ; single verse or range

; ── Magisterium ───────────────────────────────────────────────────────────────
domain-path =/ magisterium-path
magisterium-path = issuer-slug SLASH doc-slug [SLASH section-type SLASH section-id]
issuer-slug      = slug                      ; council, dicastery, or pope-{name}[-{roman}]
                                             ; (§3.2.3)
doc-slug         = slug
section-type     = "chapter" / "canon" / "paragraph" / "article"
section-id       = 1*DIGIT

; ── Catechism ─────────────────────────────────────────────────────────────────
domain-path =/ ccc-path
ccc-path    = para-num [HYPHEN para-num]
para-num    = 1*DIGIT

; ── Canon Law ─────────────────────────────────────────────────────────────────
domain-path =/ canon-path
canon-path  = code SLASH canon-num [SLASH canon-qualifier]
code        = "cic1983" / "cic1917" / "cceo"
canon-num   = 1*DIGIT
canon-qualifier = para-num                  ; paragraph number — always numeric
              / "authentic-interpretation" SLASH iso-date
                                             ; fixed keyword + ISO date — unambiguous

; ── Theological Concepts ──────────────────────────────────────────────────────
domain-path  =/ concept-path
concept-path = %x43.4E 4*8DIGIT              ; "CN", case-sensitive; opaque,
                                             ; semantics-free (see §2.6)
; concept-notation = slug                    ; skos:notation mnemonic; NOT a URI
;                                            ; path segment

; ── Works ─────────────────────────────────────────────────────────────────────
domain-path   =/ work-path
work-path     = work-slug [SLASH 1*path-segment]
work-slug     = slug                        ; registry-unique; author-qualified
                                             ; where a title is shared
path-segment  = slug                        ; one or more sub-division segments
; NOTE: 1*path-segment allows arbitrary depth for works with 3+ structural levels
; e.g., summa-theologiae/iii/q75/a1 = work / part / question / article

; ── Institutions ──────────────────────────────────────────────────────────────
domain-path       =/ institution-path
institution-path  = inst-type SLASH slug
inst-type         = "diocese" / "conference" / "council" / "order"
                  / "dicastery" / "seminary" / "eastern-church"

; ── Relationship Types ────────────────────────────────────────────────────────
domain-path =/ rel-path
rel-path    = rel-slug
rel-slug    = "magisterial-proof-text" / "patristic-interpretation"
           / "liturgical-use" / "theological-argument"
           / "typological-sense" / "anagogical-sense"
           / "defines-concept" / "supersedes" / "interprets"
           / "contradicted-by"

; ============================================================================
; Validation notes (non-normative; see spec/03-domains.md for full discussion)
;
; 1. The canon-qualifier production makes cdcf:canon/cic1983/844/1 (paragraph)
;    and cdcf:canon/cic1983/230/authentic-interpretation/1994-11-11
;    unambiguous: a paragraph qualifier is 1*DIGIT; an authentic interpretation
;    begins with the fixed keyword "authentic-interpretation". No heuristic
;    parsing is required.
;
; 2. The work-path 1*path-segment production allows Thomas Aquinas's Summa
;    (three sub-levels: part/question/article) and other scholastic works of
;    arbitrary structural depth. It carries over the variable-depth production
;    of version 0.3.0's person-path, which version 0.5.0 withdraws (§3.6.1).
;
; 3. All slug productions are restricted to lower-case ASCII (ALPHA = %x61-7A).
;    Upper-case characters are syntactically invalid in cdcf: identifiers,
;    except the fixed prefix of an opaque identifier. That prefix is written
;    as a hex literal (%x43.4E for "CN") because an ABNF quoted string is
;    case-insensitive under RFC 5234; it MUST appear in upper case. [REV-04]
;
; 4. The iso-date production in canon-qualifier enforces ISO 8601 date format
;    for authentic interpretations, ensuring consistent machine parsing
;    across implementations.
;
; 5. The osis-book slug used in book-path and verse-path MUST be the exact,
;    lower-cased OSIS 2.1.1 book ID ("john", "matt"), matching the book
;    segment of the osisRef field byte-for-byte after case-folding.
;    Implementations MUST NOT introduce a second, undocumented abbreviation
;    scheme for the same book; version 0.3.0 shipped this defect (jn, mt) and
;    it was corrected in version 0.4.0. [REV-03]
;
; 6. The concept-path production is deliberately opaque (§2.6, §3.5): it
;    carries no linguistic content and MUST NOT be derived from, or assumed to
;    match, the concept's skos:notation. A client that has only a notation
;    string MUST resolve it via the lookup in §3.5.2 before using the
;    identifier in a stored cross-reference. [REV-03]
; ============================================================================
